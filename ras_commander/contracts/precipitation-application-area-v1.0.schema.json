{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ras-commander/precipitation-application-area/1.0",
  "title": "RAS Commander precipitation application area 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "method",
    "algorithm",
    "model",
    "source_geometry_hdf",
    "source_mesh_crs",
    "source_mesh_cells_sha256",
    "target_grid",
    "spatial_reference",
    "boundary_predicate",
    "area_precision_decimal_places",
    "compiler",
    "cells",
    "metrics",
    "application_area_sha256"
  ],
  "properties": {
    "schema": {"const": "ras-commander/precipitation-application-area/1.0"},
    "method": {"const": "ras-mesh-effective-area"},
    "algorithm": {"const": "target-cell-intersection-with-mesh-union-v1"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "plan_id", "geometry_id", "two_d_flow_area"],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "plan_id": {"type": "string", "minLength": 1},
        "geometry_id": {"type": "string", "minLength": 1},
        "two_d_flow_area": {"type": "string", "minLength": 1}
      }
    },
    "source_geometry_hdf": {"$ref": "#/$defs/fileIdentity"},
    "source_mesh_crs": {"type": "string", "minLength": 1},
    "source_mesh_cells_sha256": {"$ref": "#/$defs/sha256"},
    "target_grid": {"$ref": "#/$defs/grid"},
    "spatial_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "horizontal_crs",
        "horizontal_datum",
        "horizontal_units",
        "vertical_datum"
      ],
      "properties": {
        "horizontal_crs": {"type": "string", "minLength": 1},
        "horizontal_datum": {"type": "string", "minLength": 1},
        "horizontal_units": {"const": "meters"},
        "vertical_datum": {"const": "not_applicable"}
      }
    },
    "boundary_predicate": {"const": "positive-area-intersection"},
    "area_precision_decimal_places": {"const": 9},
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shapely_version", "geos_version"],
      "properties": {
        "shapely_version": {"type": "string", "minLength": 1},
        "geos_version": {"type": "string", "minLength": 1}
      }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/cell"}
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mesh_cell_count",
        "mesh_union_area_square_meters",
        "target_cell_count",
        "inside_target_cell_count",
        "partial_target_cell_count",
        "outside_target_cell_count",
        "receiving_area_square_meters",
        "target_grid_area_square_meters"
      ],
      "properties": {
        "mesh_cell_count": {"type": "integer", "minimum": 1},
        "mesh_union_area_square_meters": {"type": "number", "exclusiveMinimum": 0},
        "target_cell_count": {"type": "integer", "minimum": 1},
        "inside_target_cell_count": {"type": "integer", "minimum": 0},
        "partial_target_cell_count": {"type": "integer", "minimum": 0},
        "outside_target_cell_count": {"type": "integer", "minimum": 0},
        "receiving_area_square_meters": {"type": "number", "exclusiveMinimum": 0},
        "target_grid_area_square_meters": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "application_area_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "size_bytes", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition_id",
        "crs",
        "shape",
        "cell_size_meters",
        "cell_area_square_meters",
        "origin",
        "row_order",
        "definition_sha256"
      ],
      "properties": {
        "definition_id": {"type": "string", "minLength": 1},
        "crs": {"type": "string", "minLength": 1},
        "shape": {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 1},
            {"type": "integer", "minimum": 1}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "cell_size_meters": {"type": "number", "exclusiveMinimum": 0},
        "cell_area_square_meters": {"type": "number", "exclusiveMinimum": 0},
        "origin": {
          "type": "array",
          "prefixItems": [{"type": "number"}, {"type": "number"}],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "row_order": {"const": "south_to_north"},
        "definition_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "row_index",
        "column_index",
        "center",
        "bounds",
        "membership",
        "effective_area_square_meters"
      ],
      "properties": {
        "cell_id": {"type": "integer", "minimum": 0},
        "row_index": {"type": "integer", "minimum": 0},
        "column_index": {"type": "integer", "minimum": 0},
        "center": {
          "type": "array",
          "prefixItems": [{"type": "number"}, {"type": "number"}],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "bounds": {
          "type": "array",
          "prefixItems": [
            {"type": "number"},
            {"type": "number"},
            {"type": "number"},
            {"type": "number"}
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "membership": {"enum": ["inside", "partial", "outside"]},
        "effective_area_square_meters": {"type": "number", "minimum": 0}
      }
    }
  }
}
